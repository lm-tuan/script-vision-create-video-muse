# Disable native C++ bufferutil binary for WebSockets to prevent runtime errors
WS_NO_BUFFER_UTIL=1

# GenMax API Key
GENMAX_API_KEY=your_genmax_api_key_here

# Beeknoee API Key (AI Text Processing)
BEEKNOEE_API_KEY=

# API local for text AI (server-side; token optional)
LOCAL_AI_BASE_URL=http://127.0.0.1:3900
LOCAL_AI_TOKEN=
LOCAL_PROMPT_BATCH_SIZE=5
LOCAL_PROMPT_COMPACT_TEMPLATE=0
LOCAL_PROMPT_PROGRESSIVE=0

# Gateway MuseAI cho tạo clip (server-side)
MUSE_BASE_URL=http://127.0.0.1:18610
MUSE_API_KEY=
